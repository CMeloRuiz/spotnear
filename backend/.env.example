# ─────────────────────────────────────────────────────────────
# SpotNear · Backend · Variables de entorno
# Copiá este archivo a `.env` y completá los valores.
# El archivo `.env` NUNCA se commitea.
#
# En Render no hay .env: estas mismas variables se cargan en el panel del
# servicio (Environment). render.yaml ya trae las que tienen un valor fijo;
# las secretas se completan a mano. Ver README → "Desplegar en Render".
# Una variable cargada pero vacía cuenta como no cargada (usa su default).
# ─────────────────────────────────────────────────────────────

# --- Entorno ---
# En Render: NODE_ENV=production. PORT no se carga: Render lo asigna solo.
NODE_ENV=development
PORT=4000

# --- Base de datos (PostgreSQL) ---
# Local:   postgresql://postgres:postgres@localhost:5432/spotnear?schema=public
# Neon:    postgresql://USER:PASS@ep-xxxx.sa-east-1.aws.neon.tech/spotnear?sslmode=require
# Supabase: postgresql://postgres.xxxx:PASS@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Render:  la completa sola el Blueprint (Internal Database URL de spotnear-db).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotnear?schema=public"

# --- JWT ---
# Generá secretos largos y aleatorios, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En Render los genera el Blueprint (generateValue). Cambiarlos cierra todas
# las sesiones abiertas.
JWT_SECRET="cambiame-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambiame-por-otro-secreto-distinto-y-aleatorio"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
# Orígenes permitidos separados por coma. Incluí la URL del frontend.
# Producción: https://spotnear-frontend.onrender.com (y tu dominio propio, si
# tenés: https://spotnear.com.ar,https://www.spotnear.com.ar).
# Con NODE_ENV=production el backend no arranca si todos son localhost.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- URLs públicas ---
# PUBLIC_WEB_URL: los links del comprobante que se mandan por WhatsApp/email.
# PUBLIC_API_URL: la usan servicios de AFUERA, así que en producción tiene que
# ser https y pública. De ella dependen:
#   · la vuelta automática desde Mercado Pago (solo funciona con https),
#   · el webhook de Mercado Pago (tiene que alcanzarla desde internet),
#   · la imagen del comprobante que Twilio descarga para mandarla por WhatsApp.
# En desarrollo, para probar esas tres cosas: cloudflared tunnel --url
# http://localhost:4000 y poné acá la URL https que imprime (ver README →
# "Probar la vuelta automática y el webhook en tu máquina").
#
# En Render: PUBLIC_WEB_URL = la URL del frontend. PUBLIC_API_URL se puede
# dejar vacía: el backend usa RENDER_EXTERNAL_URL, la URL pública que Render le
# asigna al servicio. Con NODE_ENV=production el backend no arranca si alguna
# de las dos sigue en localhost.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# --- Negocio ---
COMISION_DEFAULT_PORCENTAJE=10
TZ=America/Argentina/Buenos_Aires
MONEDA=ARS

# --- Email por SMTP (alternativa a Resend, ver RESEND_API_KEY más abajo) ---
# Si no hay ni Resend ni SMTP, el sistema NO rompe: loguea el email en consola
# y lo registra como SIMULADO en NotificationLog.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente. Con Resend, mientras el dominio no esté verificado se usa solo
# onboarding@resend.dev (no hace falta cambiar esto para empezar a probar).
MAIL_FROM="SpotNear <reservas@spotnear.com.ar>"

# --- WhatsApp: credenciales de la Cloud API de Meta (WHATSAPP_PROVIDER=cloud_api) ---
# El proveedor se elige más abajo, en "WhatsApp automático".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Reservada para una plantilla aprobada de Meta. Hoy el código no la usa: no
# hace falta cargarla (tampoco en Render).
WHATSAPP_TEMPLATE_RESERVA=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_RESERVA_MAX=20

# --- Seed y primer administrador (se usan solo al correr los scripts a mano) ---
# npm run db:seed              → datos de ejemplo. BORRA la base: solo desarrollo.
#                                Sobre una base con usuarios no corre sin --forzar.
# npm run db:crear-superadmin  → crea UN SUPERADMIN con SEED_SUPERADMIN_EMAIL y
#                                SEED_SUPERADMIN_PASSWORD (12+ caracteres), sin
#                                borrar nada. Es el que se usa en producción.
# No se cargan en Render: el script se corre desde tu máquina contra la base
# de Render (ver README → "Desplegar en Render").
SEED_SUPERADMIN_EMAIL=admin@spotnear.com.ar
SEED_SUPERADMIN_PASSWORD=SpotNear2026!
SEED_OWNER_EMAIL=dueno@estacionamientohumboldt.com.ar
SEED_OWNER_PASSWORD=Humboldt2026!
SEED_STAFF_EMAIL=playero@estacionamientohumboldt.com.ar
SEED_STAFF_PASSWORD=Playero2026!

# --- Pagos: la seña del 10% ---
#
# El cliente paga online SOLO la seña, que no se devuelve y es lo que reserva
# el lugar. El resto de la tarifa lo cobra el estacionamiento en el lugar.
#
# simulado    → da la seña por pagada al instante, sin credenciales. Deja probar
#               el flujo completo en desarrollo. Es el default.
# mercadopago → cobro real con Checkout Pro. La reserva NO se confirma, no se
#               emite comprobante y no sale el aviso al estacionamiento hasta
#               que Mercado Pago diga que el pago está aprobado.
# none        → sin pasarela: la seña queda pendiente y se resuelve a mano.
# En Render: mercadopago.
PAYMENT_PROVIDER=simulado

# Credenciales de Mercado Pago.
#   https://www.mercadopago.com.ar/developers/panel/app → tu aplicación → Credenciales
#
# Hay DOS juegos y no se mezclan:
#   · De prueba:    ACCESS_TOKEN empieza con TEST-     → se cobra con las tarjetas
#                   de prueba de Mercado Pago, no se mueve un peso real.
#   · De producción: ACCESS_TOKEN empieza con APP_USR- → plata de verdad.
#
# El access token es secreto y vive solo acá. La public key es la que podría
# ir al navegador (hoy no se usa: Checkout Pro no la necesita, la pide Bricks).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Firma de los webhooks. Panel de Mercado Pago → Webhooks → Configurar
# notificaciones → "Clave secreta". Opcional: sin ella el webhook sigue
# andando, porque el estado del pago se vuelve a leer contra la API igual.
MERCADOPAGO_WEBHOOK_SECRET=

# En Render el webhook y la vuelta automática funcionan solos: PUBLIC_API_URL
# es la URL https pública del servicio, y la notification_url de cada pago se
# arma con ella. No hay que configurar nada en el panel de Mercado Pago.
#
# IMPORTANTE (desarrollo): con PUBLIC_API_URL en http://localhost Mercado Pago no puede
# devolver al cliente solo (exige https) ni mandar el webhook. El pago igual se
# confirma: el checkout se abre en otra pestaña y la de SpotNear consulta la
# API. Para el flujo de producción completo, poné en PUBLIC_API_URL la URL de
# un túnel https (cloudflared tunnel --url http://localhost:4000).

# --- WhatsApp automático (aviso al grupo + "Enviar a mi WhatsApp" del cliente) ---
# link      → no envía solo ni puede adjuntar la imagen (default)
# twilio    → envío automático con la imagen del comprobante. Twilio descarga la
#             imagen de PUBLIC_API_URL: tiene que ser pública (o el túnel).
# cloud_api → envío automático con la Cloud API de Meta; la imagen se sube, no
#             necesita URL pública.
WHATSAPP_PROVIDER=link

# Twilio: se sacan del panel en https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox de Twilio. Con número propio aprobado, cambiarlo por ese.
TWILIO_WHATSAPP_FROM=+14155238886

# Número al que van los avisos MIENTRAS SE PRUEBA. Pisa el grupo de cada
# estacionamiento. En producción va vacío para que cada uno reciba el suyo.
WHATSAPP_GRUPO_PRUEBA=

# --- Email con Resend (el recomendado) ---
# Con solo cargar esto los emails empiezan a salir. Se saca en
# https://resend.com/api-keys (Create API Key → Sending access).
# Sin dominio verificado, Resend solo deja mandar a la casilla con la que se
# creó la cuenta. Para mandarle a cualquiera: verificá el dominio en
# https://resend.com/domains y poné un MAIL_FROM de ese dominio.
RESEND_API_KEY=
