{
  "name": "spotnear",
  "version": "1.0.0",
  "private": true,
  "description": "SpotNear - Marketplace de reservas de estacionamientos en Buenos Aires. Por ColdevIA.",
  "author": "ColdevIA",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "db:studio": "npm --prefix backend run db:studio",
    "setup": "npm run install:all && npm run db:migrate && npm run db:seed",
    "test": "npm --prefix backend test",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
