# ─────────────────────────────────────────────────────────────
# SpotNear · Frontend · Variables de entorno
# Copiá este archivo a `.env` y completá los valores.
# Solo las variables con prefijo VITE_ llegan al navegador.
# ⚠ Todo lo que pongas acá es PÚBLICO: nunca guardes secretos.
# ─────────────────────────────────────────────────────────────

# URL base de la API
VITE_API_URL=http://localhost:4000/api/v1

# --- Google Maps ---
# Habilitá en Google Cloud: "Maps JavaScript API" y "Places API (New)".
# Restringí la key por referrer HTTP (localhost:5173 y tu dominio) y por API.
# Sin key, la app igual funciona: muestra un mapa alternativo propio y usa un
# buscador de direcciones con los barrios de Buenos Aires.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID de Google (necesario para los marcadores avanzados con el precio).
# Se crea en Google Cloud → Map Management. Para probar podés dejar DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Marca ---
VITE_NOMBRE_APP=SpotNear
VITE_EMPRESA=ColdevIA
VITE_WHATSAPP_SOPORTE=+5491112345678
